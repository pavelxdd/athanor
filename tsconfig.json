{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react",
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "outDir": "./.webpack",
    "sourceMap": true
  },
  "include": ["src/**/*", "electron/**/*", "electron/handlers/**/*", "common/**/*"],
  "exclude": ["node_modules", "out"]
}
